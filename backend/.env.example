# Environnement
NODE_ENV=development
PORT=4000

# Base de données (MongoDB Atlas ou local)
# Prisma nécessite un replica set MongoDB, même en local (voir README backend / ARCHITECTURE_DECISIONS.md)
MONGODB_URI=mongodb://localhost:27017/lc_cocody_digital_hub?replicaSet=rs0

# JWT
JWT_SECRET=change-me-in-.env-never-commit-real-secret
JWT_EXPIRES_IN=1d

# CORS
CORS_ORIGIN=http://localhost:5173
